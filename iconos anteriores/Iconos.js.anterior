import {
  FaTrashAlt,
  FaBiohazard,
  FaRadiationAlt,
  FaWater,
  FaOilCan,
  FaTint,
  FaDumpster,
  FaRecycle,
  FaIndustry,
  FaUtensils,
  FaStore,
  FaSchool,
  FaShoppingBasket,
  FaHospital,
  FaTruck,
  FaShieldAlt,
  FaClock,
  FaFileContract,
} from "react-icons/fa";

/**
 * Icono lineal de Residuos de Manejo Especial, dibujado a partir del
 * logotipo RME del cliente (triángulo de flechas de reciclaje en trazo).
 * Mismo contrato que los iconos de react-icons: 1em y currentColor.
 */
function IconoRME({ size, ...props }) {
  const lado = size ? `${size}px` : "1em";
  return (
    <svg
      viewBox="0 0 24 24"
      width={lado}
      height={lado}
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
      {...props}
    >
      <path d="M10.8 7 L6.8 14 M6.8 14 l2.3 -1.3 M6.8 14 l0 -2.6" />
      <path
        d="M10.8 7 L6.8 14 M6.8 14 l2.3 -1.3 M6.8 14 l0 -2.6"
        transform="rotate(120 12 12.5)"
      />
      <path
        d="M10.8 7 L6.8 14 M6.8 14 l2.3 -1.3 M6.8 14 l0 -2.6"
        transform="rotate(240 12 12.5)"
      />
    </svg>
  );
}

const MAPA = {
  // Servicios
  basura: FaTrashAlt,
  biologico: FaBiohazard,
  rme: IconoRME,
  peligro: FaRadiationAlt,
  agua: FaWater,
  aceite: FaOilCan,
  gota: FaTint,
  contenedor: FaDumpster,
  reciclar: FaRecycle,
  // Sectores
  fabrica: FaIndustry,
  restaurante: FaUtensils,
  tienda: FaStore,
  escuela: FaSchool,
  mercado: FaShoppingBasket,
  hospital: FaHospital,
  // Confianza
  camion: FaTruck,
  escudo: FaShieldAlt,
  reloj: FaClock,
  documento: FaFileContract,
};

export default function Icono({ nombre, ...props }) {
  const Componente = MAPA[nombre];
  if (!Componente) return null;
  return <Componente aria-hidden="true" {...props} />;
}
