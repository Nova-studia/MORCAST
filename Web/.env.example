# Copia este archivo como .env.local y llena los valores reales.
# NUNCA subas .env.local al repositorio.
# Los valores salen de Supabase → Project Settings → API.

# ---------------------------------------------------------------------
# Supabase — lado del NAVEGADOR
# ---------------------------------------------------------------------
# Estas dos llevan NEXT_PUBLIC_ porque viajan al navegador a propósito.
# La llave anónima es pública por diseño: por sí sola no da acceso a nada,
# quien decide qué ve cada quien son las políticas RLS (db/002-rls.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Supabase — lado del SERVIDOR
# ---------------------------------------------------------------------
# 🔒 La llave de servicio SALTA todas las políticas de seguridad.
# Jamás la pongas con NEXT_PUBLIC_ ni la importes desde un componente
# marcado con "use client": quedaría publicada en el sitio.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Resend (correos: confirmación al interesado + aviso interno + invitaciones)
# ---------------------------------------------------------------------
RESEND_API_KEY=
# Buzón que recibe el aviso de cada solicitud (default: contacto@morcast.mx)
CORREO_AVISOS=
