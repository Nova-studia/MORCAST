{
  "expo": {
    "name": "Morcast",
    "slug": "morcast-app",
    "scheme": "morcast",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1615",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.morcast.app"
    },
    "android": {
      "package": "mx.morcast.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f1615",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 5,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Morcast usa tus fotos para subir el comprobante de pago.",
          "cameraPermission": "Morcast usa la cámara para tomar la foto del comprobante de pago."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Morcast usa la cámara para escanear el QR del contenedor y tomar la foto de la recolección."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Morcast usa tu ubicación solo en el modo chofer: para guardar dónde está un punto de recolección y para mandar tu ubicación al reportar un problema."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2a6a99",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/quitar-permisos.js",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#17211f"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "52f57e01-9209-404a-bb45-f25bab58f105"
      }
    },
    "owner": "morcastmx",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/52f57e01-9209-404a-bb45-f25bab58f105",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
